{
    "name": "amravatisms/laravel-whatsapp",
    "description": "Official Laravel SDK for AmravatiSMS WhatsApp Business API",
    "keywords": ["laravel", "whatsapp", "amravatisms", "whatsapp-business-api", "messaging"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "AmravatiSMS",
            "email": "support@amravatisms.com"
        }
    ],
    "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "illuminate/http": "^10.0|^11.0|^12.0",
    "illuminate/database": "^10.0|^11.0|^12.0",
    "guzzlehttp/guzzle": "^7.0"
	},
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "suggest": {
        "filament/filament": "Required for the Filament plugin (^3.0)"
    },
    "autoload": {
        "psr-4": {
            "AmravatiSMS\\LaravelWhatsApp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmravatiSMS\\LaravelWhatsApp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AmravatiSMS\\LaravelWhatsApp\\WhatsAppServiceProvider"
            ],
            "aliases": {
                "AmravatiSMS": "AmravatiSMS\\LaravelWhatsApp\\Facades\\AmravatiSMS"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}